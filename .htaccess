# Eastmans Developments - hosting rules (Apache / LiteSpeed, as used by Hostinger)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: send www to the bare domain, preserving path and query.
  RewriteCond %{HTTP_HOST} ^www\.eastmans\.london$ [NC]
  RewriteRule ^(.*)$ https://eastmans.london/$1 [R=301,L]

  # Keep the existing HTTP to HTTPS upgrade.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://eastmans.london/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Fonts, scripts and stylesheets are referenced with a ?v= content hash, so
  # caching them hard is safe: a changed file gets a new URL. Images are not
  # versioned yet, so they keep the server's shorter default. HTML stays fresh so the
  # new hashes are picked up on the next visit.
  <FilesMatch "\.(woff2|png|svg|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp

# Internal working files (the design brief, build tools, Git metadata) are not
# part of the site. Return 404 if the repository is uploaded in full.
RedirectMatch 404 ^/(tools/|REBRAND_PROMPT\.md|.*\.py$|\.git)
